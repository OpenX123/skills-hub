  "_note": "分层种子源。tier 0=官方规范基准 / 1=元索引(可展开长尾) / 2=人工精选内容源 / 3=长尾。role: content=仓库内含真实资源文件; curated-index=README 榜单,只采集链接作为交叉命中投票信号; both=两者皆有; tool=生态工具仓库。所有 repo 已于 2026-07-26 验证可访问。",

  "registries": [
    {
      "id": "mcp-official",
      "kind": "mcp-registry",
      "tier": 0,
      "enabled": true,
      "url": "https://registry.modelcontextprotocol.io/v0/servers",
      "incremental": "updated_since",
      "note": "官方 MCP Registry,免鉴权,支持 updated_since 增量"
    },
    {
      "id": "skills-sh",
      "kind": "http-api",
      "tier": 0,
      "enabled": false,
      "url": "https://www.skills.sh/api/v1",
      "auth": "vercel-oidc",
      "envVar": "VERCEL_OIDC_TOKEN",
      "note": "2026-07-26 实测全部端点返回 401,需 Vercel OIDC token。拿到 token 后置 enabled=true,即可接管全量榜单 / 安装量 / hot 时间序列 / 官方审计结论"
    }
  ],

